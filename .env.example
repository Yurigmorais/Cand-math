# ============================================================
#  CANDY MATH — .env.example
#  Copie para .env na raiz e preencha. O .env está no .gitignore e nunca
#  vai para o repositório — quem lê este arquivo é testes/testar-autorizacao.js.
#
#  QUEM LÊ O QUÊ:
#    · O navegador NÃO lê este arquivo. As duas variáveis PUBLICAS abaixo
#      existem só para os testes e para o script de subir config; no jogo
#      elas vivem em config.js, que é público por natureza.
#    · As variáveis SECRETAS são lidas apenas pela função serverless
#      api/voz.js, dentro da Vercel. Elas nunca chegam ao navegador e nunca
#      aparecem em config.js.
#
#  Na Vercel: Settings → Environment Variables. Marque "Sensitive" nas
#  secretas e NÃO marque "Exposed to the Browser" em nenhuma.
# ============================================================

# ── Pública (o mesmo valor que vai em config.js) ──────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-publica-anon

# ── Secretas (só no servidor da Vercel) ───────────────────
# Criada em fish.audio → Developer → API Keys. Guardada aqui, nunca no front.
FISH_AUDIO_API_KEY=

# Chave de serviço do MESMO projeto Supabase (Settings → API → service_role).
# É o que permite à função de voz escrever e ler o cache de áudio na tabela
# public.narracoes e no bucket privado "narracoes". Ela bypassa o RLS, então é
# o segredo mais pesado deste arquivo: só a função serverless a vê, o navegador
# jamais, e nenhuma das duas coisas aparece em config.js.
# Deixe vazia e o cache fica desligado: a função passa a chamar a Fish Audio em
# toda frase, como era antes de existir cache.
SUPABASE_SERVICE_ROLE_KEY=

# ── Ajustes opcionais da função de voz (deixe vazio = usa o padrão) ──
# Só fazem diferença dentro da Vercel, onde a função roda. Os padrões estão
# escritos em api/_voz-nucleo.js e explicados na tabela de CONFIGURACAO-DEPLOY.md.
# FISH_AUDIO_MODELO=s2.1-pro-free   # modelo enviado no cabeçalho "model"
# FISH_AUDIO_MAX=320                 # teto de caracteres por frase (8–2000)
# FISH_AUDIO_POR_HORA=240            # frases por IP por hora, antes do 429
# CM_ORIGENS=https://SEU-PROJETO.vercel.app   # origens que podem chamar a função
# CM_CACHE_TETO=6000                 # frases guardadas antes da poda
# CM_CACHE=off                       # "off" desliga o cache sem mexer nas chaves

# ── Ambiente de teste de autorização (testes/testar-autorizacao.js) ──
# São contas de teste criadas por você no próprio projeto Supabase.
# O teste se autodeclara "pendente" quando estas linhas estão vazias.
CM_TESTE_1_EMAIL=
CM_TESTE_1_SENHA=
CM_TESTE_2_EMAIL=
CM_TESTE_2_SENHA=

# ── Postgres local, se você quiser rodar testes/testar-rls.sql ────────
# Usado por `psql`/`supabase db push`. Não é necessário para o jogo.
DATABASE_URL=
